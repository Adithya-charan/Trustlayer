        ]
      ]
    },
    "Any alerts?": {
      "main": [
        [
          {
            "node": "Report no new events",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record alert": {
      "main": [
        [
          {
            "node": "Development notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Development notification": {
      "main": [
        [
          {
            "node": "Summarise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarise": {
      "main": [
        [
          {
            "node": "Report alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}