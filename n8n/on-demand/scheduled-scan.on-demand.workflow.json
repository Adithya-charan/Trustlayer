{
  "name": "TrustLayer - Scheduled scan (on demand)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trustlayer-on-demand-scan",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        380
      ],
      "webhookId": "24552346-dc98-5f82-b902-dd5565b2180f",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Trigger Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "baseUrl",
              "value": "http://127.0.0.1:8000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        380
      ],
      "notes": "Set baseUrl to where n8n can reach the TrustLayer backend. No secrets here: the key lives in the n8n credential."
    },
    {
      "parameters": {
        "jsCode": "// One key per hour: a repeated trigger inside the hour returns the original scan instead of starting another.\nconst slot = new Date().toISOString().slice(0, 13);\nreturn [{ json: { key: `scan-${slot}` } }];"
      },
      "id": "idempotency-key",
      "name": "Idempotency key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/scans",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.key }}"
            }
          ]
        }
      },
      "id": "start-scan",
      "name": "Start scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "scan-completed?",
      "name": "Scan completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/workflow-runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'run-scan-' + $execution.id + '-' + $now.toMillis() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'scheduled-scan', status: 'SUCCESS', attempt: 1, detail: 'scan #' + $('Start scan').first().json.id + ' ' + $('Start scan').first().json.status + ': ' + $('Start scan').first().json.sensitive_found + '/' + $('Start scan').first().json.fields_scanned + ' sensitive fields, exec ' + $execution.id }) }}"
      },
      "id": "report-success",
      "name": "Report success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        220
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/workflow-runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'run-scan-' + $execution.id + '-' + $now.toMillis() + '-failed' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'scheduled-scan', status: 'FAILED', attempt: 3, detail: 'scan did not complete after 3 attempts (exec ' + $execution.id + ')' }) }}"
      },
      "id": "report-failure",
      "name": "Report failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      }
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "TrustLayer scheduled scan failed (see Automation page for the run report)"
      },
      "id": "fail-execution",
      "name": "Fail execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1480,
        460
      ],
      "notes": "Marks the n8n execution as failed after the failure was reported to TrustLayer. Static message only."
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Idempotency key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idempotency key": {
      "main": [
        [
          {
            "node": "Start scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start scan": {
      "main": [
        [
          {
            "node": "Scan completed?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan completed?": {
      "main": [
        [
          {
            "node": "Report success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report failure": {
      "main": [
        [
          {
            "node": "Fail execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
