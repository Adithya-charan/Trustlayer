{
  "name": "TrustLayer - Audit summary report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {},
      "id": "manual-test",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        460
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "baseUrl",
              "value": "http://127.0.0.1:8000",
              "type": "string"
            },
            {
              "id": "2",
              "name": "periodHours",
              "value": 24,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        380
      ],
      "notes": "Set baseUrl to where n8n can reach the TrustLayer backend. No secrets here: the key lives in the n8n credential."
    },
    {
      "parameters": {
        "jsCode": "// One report per UTC day. Re-running the workflow the same day does not create a second report.\nconst hours = Math.min(Math.max($('Config').first().json.periodHours || 24, 1), 168);\nreturn [{ json: { hours, key: `report-${new Date().toISOString().slice(0, 10)}-${hours}h` } }];"
      },
      "id": "period-key",
      "name": "Period key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        380
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hours",
              "value": "={{ $json.hours }}"
            }
          ]
        }
      },
      "id": "fetch-summary",
      "name": "Fetch summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $input.first().json.body;\nif (!s || typeof s.window_hours !== 'number' || typeof s.decisions !== 'object' || s.decisions === null) throw new Error('unexpected response from the summary endpoint');\nconst sum = o => Object.values(o || {}).reduce((a, b) => a + b, 0);\nconst report = { decisions: s.decisions, operations: s.operations, security_events: s.security_events, scans: s.scans,\n  sensitive_fields: s.sensitive_fields, totals: { audit_events: sum(s.decisions), security_events: sum(s.security_events) },\n  window_hours: s.window_hours };\nreturn [{ json: { period_key: $('Period key').first().json.key, period_start: s.period_start, period_end: s.period_end, report } }];"
      },
      "id": "build-report",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        380
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "store-report",
      "name": "Store report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/workflow-runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'run-report-' + $execution.id }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'summary-report', status: 'SUCCESS', attempt: 1, detail: ($json.duplicate ? 'report already stored for this period' : 'report stored') + '; exec ' + $execution.id }) }}"
      },
      "id": "report-success",
      "name": "Report success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/workflow-runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'run-report-' + $execution.id + '-failed' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'summary-report', status: 'FAILED', attempt: 3, detail: 'summary report failed after 3 attempts (exec ' + $execution.id + ')' }) }}"
      },
      "id": "report-failure",
      "name": "Report failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        560
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "TrustLayer Automation Key"
        }
      }
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "TrustLayer audit summary report failed (see Automation page for the run report)"
      },
      "id": "fail-execution",
      "name": "Fail execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1220,
        560
      ],
      "notes": "Marks the n8n execution as failed after the failure was reported to TrustLayer. Static message only."
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Period key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Period key": {
      "main": [
        [
          {
            "node": "Fetch summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch summary": {
      "main": [
        [
          {
            "node": "Build report",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build report": {
      "main": [
        [
          {
            "node": "Store report",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store report": {
      "main": [
        [
          {
            "node": "Report success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report failure": {
      "main": [
        [
          {
            "node": "Fail execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}