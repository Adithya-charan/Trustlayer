# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
# Neon: Dashboard -> Connect -> copy the connection string, then change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional separate database for tests (never point this at your real data)
TEST_DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
N8N_SHARED_SECRET=change-me-to-a-different-long-random-string
CORS_ORIGINS=http://localhost:5173
DEMO_PASSWORD=choose-a-demo-password-for-synthetic-users
# Where the dashboard's Automation page links to the n8n editor (local n8n default)
N8N_EDITOR_URL=http://localhost:5678

# Voice assistant (optional). Get a key from the Groq console; never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Speech (optional). Sarvam speech-to-text and text-to-speech. Never commit real keys.
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=priya

# Live voice (optional): LiveKit room, agent worker and Tavus avatar. Never commit real values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=
# Random 32+ character string the agent worker presents to the backend (generate your own)
VOICE_AGENT_SECRET=

# On-demand n8n workflows (optional): base URL of n8n's production webhooks and a random header secret for them
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_TRIGGER_SECRET=

# B1 data-protection engine (organizer's Saffron Bank dataset). Both are optional; defaults shown.
# Three read-only backends: Neon PostgreSQL (DATABASE_URL above), the organizer's SQLite file, and MySQL.
# Schema holding the Saffron tables in Neon (created by scripts/load_saffron_pg.py)
B1_PG_SCHEMA=saffron_bank
# Organizer's SQLite file (opened read-only; relative paths resolve from backend/)
B1_SQLITE_PATH=data/saffron_bank.db
# MySQL database holding the Saffron tables (a read-only account is best). Leave empty and the MySQL backend shows "not configured".
B1_MYSQL_URL=

# Hybrid PII detection (optional ML model; rules always run). Placeholders only.
DETECTION_ML_ENABLED=true
DETECTION_ML_MODEL=urchade/gliner_multi_pii-v1
DETECTION_ML_THRESHOLD=0.5
DETECTION_ML_MAX_VALUES=200
DETECTION_ML_FALLBACK=rules_only
UPLOAD_MAX_BYTES=5000000
UPLOAD_MAX_ROWS=50000
# Optional: keep the downloaded model on another drive
# HF_HOME=E:/hf_cache

# Database discovery (Neon / SQLite): let the ML model SUPPLEMENT the original classifier. Off by default; see docs/DB_DISCOVERY_ML.md.
B1_ML_SUPPLEMENT=false
B1_ML_SUPPLEMENT_VALUES=40
