# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
# Neon: Dashboard -> Connect -> copy the connection string, then change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional separate database for tests (never point this at your real data)
TEST_DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
N8N_SHARED_SECRET=change-me-to-a-different-long-random-string
CORS_ORIGINS=http://localhost:5173
DEMO_PASSWORD=choose-a-demo-password-for-synthetic-users
# Where the dashboard's Automation page links to the n8n editor (local n8n default)
N8N_EDITOR_URL=http://localhost:5678
